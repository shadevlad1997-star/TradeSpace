APP_NAME=TradeSpace
APP_VERSION=2.0.0-rc2
BRAND_CONFIG_PATH=branding/default.yml
ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_64_CHARS_RANDOM
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=7
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE
POSTGRES_DB=CHANGE_ME_DB_NAME
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_DB_USER:CHANGE_ME_STRONG_RANDOM_VALUE@db:5432/CHANGE_ME_DB_NAME
SYNC_DATABASE_URL=postgresql+psycopg://CHANGE_ME_DB_USER:CHANGE_ME_STRONG_RANDOM_VALUE@db:5432/CHANGE_ME_DB_NAME
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE
REDIS_URL=redis://:CHANGE_ME_STRONG_RANDOM_VALUE@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_RANDOM_VALUE@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_RANDOM_VALUE@redis:6379/2
CORS_ORIGINS=https://pay.example.com
CSRF_TRUSTED_ORIGINS=https://pay.example.com
TRUSTED_HOSTS=pay.example.com,api
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64
SUPERADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE
SUPERADMIN_2FA_SECRET=CHANGE_ME_BASE32_SECRET
SEED_DEMO_DATA=false
ALLOW_SANDBOX_KEYS_IN_PRODUCTION=false
CABINET_POLL_INTERVAL_SECONDS=10
PLATFORM_WEBHOOK_RETRY_LIMIT=5
WEBHOOK_LEASE_SECONDS=120
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_RETRY_MAX_SECONDS=3600
WEBHOOK_RETRY_JITTER_SECONDS=15
WEBHOOK_RETRY_AFTER_MAX_SECONDS=3600
WEBHOOK_SIGNING_KEY_OVERLAP_SECONDS=86400
RATE_LIMIT_DEFAULT=120/minute
LOGIN_RATE_LIMIT=10/minute
AUTH_FAILURE_LIMIT=7
AUTH_LOCKOUT_SECONDS=900
TWOFA_FAILURE_LIMIT=5
TWOFA_LOCKOUT_SECONDS=900
REFRESH_RATE_LIMIT=30/minute
MERCHANT_RATE_LIMIT=300/minute
RATE_LIMIT_FAIL_CLOSED_IN_PRODUCTION=true
RATE_LIMIT_REDIS_FAILURE_RETRY_AFTER_SECONDS=30
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300
MERCHANT_HMAC_V1_ENABLED=false
SESSION_COOKIE_NAME=processing_session
SESSION_COOKIE_MAX_AGE_SECONDS=7200
MAX_REQUEST_BODY_BYTES=6000000
DEFAULT_MIN_AMOUNT=1
DEFAULT_MAX_AMOUNT=1000000
DOCS_ENABLED=false
OPENAPI_ENABLED=false
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_STRONG_RANDOM_VALUE
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
SETTLEMENT_USDT_RUB_RATE=100.00
SETTLEMENT_TRANSFER_FEE_USDT=5.00
RAPIRA_RATES_ENABLED=true
RAPIRA_RATES_URL=https://api.rapira.net/open/market/rates
RAPIRA_RATES_TIMEOUT_SECONDS=5
RAPIRA_RATES_CACHE_SECONDS=15
DEPOSIT_PROCESSING_TTL_SECONDS=900
ROLLING_RAPIRA_MAX_AGE_SECONDS=60

# Controlled presentation rollout; keep false until the TradeSpace wave is approved.
TRADESPACE_UI_ENABLED=false

# Owner approval gate for new merchant Production activations (not enabled by migration).
PRODUCTION_ACTIVATION_ENABLED=false
