{
  "areas": [
    {
      "id": "FZ-01",
      "patterns": [
        "app/models/*.py",
        "app/core/enums.py",
        "alembic/versions/*.py"
      ],
      "reason": "Production schema, persisted entities, constraints and migration history."
    },
    {
      "id": "FZ-02",
      "patterns": [
        "app/api/deps.py",
        "app/core/merchant_hmac.py",
        "app/services/merchant_api_keys.py",
        "app/services/integration_modes.py",
        "app/api/v1/integration.py",
        "app/db/session.py",
        "app/core/config.py"
      ],
      "reason": "Merchant HMAC, replay protection and API-key mode are external security contracts."
    },
    {
      "id": "FZ-03",
      "patterns": [
        "app/core/security.py",
        "app/core/logging.py",
        "app/core/session.py",
        "app/core/middleware.py",
        "app/core/auth_hardening.py",
        "app/core/rate_limit.py",
        "app/core/client_ip.py",
        "app/core/access.py",
        "app/web/__init__.py",
        "app/presentation/tradespace/routes.py",
        "app/presentation/tradespace/wallet.py",
        "app/web/bank_connections.py",
        "app/services/bank_connections.py"
      ],
      "reason": "Shared authentication, realm, CSRF/session, product-only entry routes and wallet-reader authorization."
    },
    {
      "id": "FZ-04",
      "patterns": [
        "app/api/v1/merchant.py",
        "app/services/aggregators.py"
      ],
      "reason": "Idempotent Deposit/Aggregator creation and initial collateral reservation."
    },
    {
      "id": "FZ-05",
      "patterns": [
        "app/services/requisites.py",
        "app/services/payment_qr.py"
      ],
      "reason": "Deterministic routing, Requisite eligibility and collateral reservation."
    },
    {
      "id": "FZ-06",
      "patterns": [
        "app/services/fee_tiers.py",
        "app/services/fees.py",
        "app/services/platform_income.py"
      ],
      "reason": "Fee resolution, immutable fee snapshots and platform-margin mathematics."
    },
    {
      "id": "FZ-07",
      "patterns": [
        "app/services/ledger.py",
        "app/services/finance_reconciliation.py"
      ],
      "reason": "Merchant/Trader balance mutation and reconciliation semantics."
    },
    {
      "id": "FZ-08",
      "patterns": [
        "app/services/deposit_confirmation.py",
        "app/services/deposit_lifecycle.py",
        "app/services/deposit_ttl.py"
      ],
      "reason": "Authoritative Deposit confirmation, failure and expiration transitions."
    },
    {
      "id": "FZ-09",
      "patterns": [
        "app/services/payouts.py"
      ],
      "reason": "Existing Payout reservation, completion and release accounting."
    },
    {
      "id": "FZ-10",
      "patterns": [
        "app/services/rolling.py",
        "app/services/rapira.py"
      ],
      "reason": "Rolling funding, FIFO recovery and strict financial quote behavior."
    },
    {
      "id": "FZ-11",
      "patterns": [
        "app/services/teamlead.py"
      ],
      "reason": "TeamLead attribution, accrual, debt, reversal and settlement accounting."
    },
    {
      "id": "FZ-12",
      "patterns": [
        "app/services/settlements.py"
      ],
      "reason": "Merchant settlement freeze, completion and rejection accounting."
    },
    {
      "id": "FZ-13",
      "patterns": [
        "app/services/appeals.py",
        "app/services/sms.py"
      ],
      "reason": "Appeal and SMS paths that can change Deposit and financial outcomes."
    },
    {
      "id": "FZ-14",
      "patterns": [
        "app/services/webhook_payloads.py",
        "app/services/webhooks.py",
        "app/services/webhook_signing_keys.py",
        "app/services/webhook_enqueue.py"
      ],
      "reason": "Webhook payload, signature, durable delivery and enqueue semantics."
    },
    {
      "id": "FZ-15",
      "patterns": [
        "app/api/v1/aggregator.py",
        "app/services/aggregators.py",
        "app/services/aggregator_credentials.py",
        "app/services/aggregator_enqueue.py"
      ],
      "reason": "Aggregator processing, authentication and callback delivery semantics."
    },
    {
      "id": "FZ-16",
      "patterns": [
        "app/services/risk.py",
        "app/services/antiscam.py",
        "app/services/compliance.py",
        "app/core/compliance.py",
        "app/core/validators.py",
        "app/core/payment_methods.py",
        "app/core/requisite_providers.py",
        "app/core/russian_banks.py",
        "app/core/mobile_operators.py"
      ],
      "reason": "Risk, antiscam, compliance and provider eligibility used by routing."
    },
    {
      "id": "FZ-17",
      "patterns": [
        "app/workers/*.py"
      ],
      "reason": "Celery lifecycle, expiration and delivery scheduling."
    },
    {
      "id": "FZ-18",
      "patterns": [
        "app/web/routes.py",
        "app/web/payment_qr.py",
        "app/api/v1/admin.py",
        "app/api/v1/cabinet.py",
        "app/api/v1/router.py",
        "app/schemas/common.py",
        "app/main.py"
      ],
      "reason": "Existing browser/admin mutation handlers, schemas and API contract ordering."
    }
  ],
